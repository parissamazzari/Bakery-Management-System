# Copy this file to .env before running `docker compose up`.
# .env itself is gitignored so real/local secrets never get committed.

# --- PostgreSQL ---
POSTGRES_DB=bakery
POSTGRES_USER=bakery_user
POSTGRES_PASSWORD=bakery_pass

# --- RabbitMQ ---
RABBITMQ_USER=bakery
RABBITMQ_PASSWORD=bakery_pass
ORDER_QUEUE_NAME=order_processing

# --- Redis ---
PRODUCT_CACHE_TTL_SECONDS=30

# --- App ---
LOG_LEVEL=INFO
PROCESSING_DELAY_SECONDS=3
